# ============================================================
# Silvijn Studio AI — environment variables
# Kopieer naar .env.local (nooit committen) en vul waarden in.
# In Vercel: Project Settings → Environment Variables.
# NOOIT echte waarden committen of delen.
# ============================================================

# --- AI (Fase 4) ---
# Anthropic API-sleutel (server-side only, nooit in client-code)
ANTHROPIC_API_KEY=
# AI-mode: "mock" (default, geen kosten) of "live" (echte Anthropic API)
AI_MODE=mock
# Optioneel: model-ID's per tier overschrijven (defaults staan in lib/ai/config.ts)
AI_MODEL_FAST=claude-haiku-4-5
AI_MODEL_BALANCED=claude-sonnet-5
AI_MODEL_POWERFUL=claude-opus-5
# Safety-limiet: maximaal aantal AI-verzoeken per service-run (default 5)
AI_MAX_REQUESTS_PER_RUN=5

# --- Supabase (Fase 4) ---
# Project URL (publiek veilig)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (publiek veilig, voor toekomstige client-side authenticatie)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key — UITSLUITEND server-side (bypasses RLS); nooit in client-code
SUPABASE_SECRET_KEY=
