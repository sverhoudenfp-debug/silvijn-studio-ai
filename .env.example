# ============================================================
# Silvijn Studio AI — environment variables
# Kopieer naar .env.local (nooit committen) en vul waarden in.
# In Vercel: Project Settings → Environment Variables.
# NOOIT echte waarden committen of delen.
# ============================================================

# --- AI (Fase 4) ---
# Anthropic API-sleutel (server-side only, nooit in client-code)
ANTHROPIC_API_KEY=
# AI-mode: "mock" (default, geen kosten) of "live" (echte Anthropic API)
AI_MODE=mock
# Optioneel: model-ID's per tier overschrijven (defaults staan in lib/ai/config.ts)
AI_MODEL_FAST=claude-haiku-4-5
AI_MODEL_BALANCED=claude-sonnet-5
AI_MODEL_POWERFUL=claude-opus-5
# Safety-limiet: maximaal aantal AI-verzoeken per service-run (default 5)
AI_MAX_REQUESTS_PER_RUN=5

# --- Supabase (Fase 4) ---
# Project URL (publiek veilig)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (publiek veilig, voor toekomstige client-side authenticatie)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key — UITSLUITEND server-side (bypasses RLS); nooit in client-code
SUPABASE_SECRET_KEY=

# --- Lead Discovery (Fase 5) ---
# Max aantal kandidaten per handmatige discovery-run (default 50, hard max 200)
MAX_DISCOVERY_RESULTS=50
# Live technische website-checks aan/uit (default uit; een URL zonder check = unknown)
WEBSITE_CHECKS_ENABLED=false
# Toekomstige echte providers — namen; NIET actief zonder configuratie
GOOGLE_PLACES_API_KEY=
DIRECTORY_API_KEY=

# --- AI Outreach (Fase 6) ---
# Tier voor de outreach-agent (fast/balanced/powerful); leeg = agent-default balanced
OUTREACH_AI_TIER=
# Max outreach-concepten per service-run (default 5, hard max 25)
MAX_OUTREACH_GENERATIONS_PER_RUN=5

# --- AI Sales Agent (Fase 7) ---
# Tier voor de sales-agent (fast/balanced/powerful); leeg = agent-default balanced
SALES_AI_TIER=
# Max sales-analyses per service-run (default 5, hard max 25)
MAX_SALES_ANALYSES_PER_RUN=5

# --- Projects + Pricing Engine (Fase 8) ---
# Tier voor de pricing-agent (fast/balanced/powerful); leeg = agent-default balanced
PRICING_AI_TIER=
# Max AI-requirements-analyses per service-run (default 5, hard max 25); prijsberekening zelf kost geen AI
MAX_PRICING_ANALYSES_PER_RUN=5

# --- Website Generation Engine (Fase 9) ---
# Tier voor de website-generation-agent (fast/balanced/powerful); leeg = agent-default balanced,
# POWERFUL alleen bij complexe requirements (e-commerce/custom/integraties) tenzij expliciet overschreven
WEBSITE_GENERATION_AI_TIER=
# Max websitegeneraties per service-run (default 3, hard max 10) — elke generatie is 1 gecontroleerde AI-call
MAX_WEBSITE_GENERATIONS_PER_RUN=3

# --- Quality Control + Human Approval (Fase 10) ---
# Tier voor de QC-agent (fast/balanced/powerful); leeg = agent-default balanced
WEBSITE_QC_AI_TIER=
# Weergavenaam van de menselijke approver (agency-user-abstraction tot echte auth er is)
AGENCY_APPROVER_NAME=Silvijn

# --- Automation Engine (Fase 11) ---
# Autonomieniveau: 0=manual, 1=suggested (default), 2=semi-automatic, 3=controlled autonomous (NIET activeren)
AUTOMATION_AUTONOMY_LEVEL=1
# Technische veiligheidslimieten (geen commerciële waarden):
AUTOMATION_MAX_RUNS_PER_HOUR=10
AUTOMATION_MAX_RUNS_PER_DAY=50
AUTOMATION_MAX_AI_CALLS_PER_RUN=10
AUTOMATION_MAX_LEADS_PER_DISCOVERY_RUN=25
AUTOMATION_MAX_RETRIES_PER_STEP=3
AUTOMATION_MAX_CONCURRENT_RUNS=2
AUTOMATION_MAX_COST_USD_PER_RUN=1
AUTOMATION_MAX_STEPS_PER_RUN=25
AUTOMATION_MAX_RUNTIME_MS_PER_RUN=600000
